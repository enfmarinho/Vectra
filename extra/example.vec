// This is an example of a program in the language 

import Vector
import assert
import "../other_file.vec"

const int x = 4

block Matrix:
    public Matrix(int h, int w):
        height = h
        width = w
        m.resize(h)
        foreach l in m:
            l.resize(w)

    public ~Matrix():
        println("destructed")

    public func operator[](int i) -> Vector:
        return m[i]
    public func at(int i, int j) -> int:  
        return m[i][j]

    public matrix operator+(matrix lhs, matrix rhs):
        assert(lhs.width() == rhs.width())
        assert(lhs.height() == rhs.height())

        matrix r(lhs.height(), lhs.width());
        for int i = 0; i < lhs.height(); i += 1:
            for int j = 0; j < lhs.width(); j += 1:
                r = lhs.at(i, j) + rhs.at(i, j)

        return r

    public matrix operator*(matrix lhs, int rhs):
        foreach l in m:
            foreach e in l:
                e *= rhs

    private Vector<Vector<int>> m;
    private int height;
    private int widht;

enum DAY:
	SEGUNDA,
	TERCA,
	QUARTA,
	QUINTA,
	SEXTA,
	SABADO,
	DOMINGO,

// Procedure to swap two values, marking its return type as void is optional
func swap(ref(int) a, ref(int) b) -> void:
    int tmp = deref(a)
    deref(a) = deref(b)
    deref(b) = tmp

func swap_xor(ref(int) a, ref(int) b) -> void:
    deref(a) = deref(a) ^ deref(b)
    deref(b) = deref(a) ^ deref(b)
    deref(a) = deref(a) ^ deref(b)

// Testing swap procedure
func main() -> int:
    int x
    int y
    ref(int) xr = ref(x)
    ref(int) yr = ref(y)

    x = 42
    y = 84
    swap(xr, yr)

    matrix m(x, y)
    
    if x > 80:
	    println("x maior que 80")
    else if x > 40:
