struct Matrix:
    private int height
    private int width
    private Vector<vector<int>> m

impl Matrix:
    static func new() -> Matrix:
        return Matrix {
            height = 0
            width = 0
        }
    
    public func consult(int i, int j) -> int:
        return m[i][j]


func main():
    Matrix a = Matrix::new()
    a.consult(0, 0) // Out of bound, that is just an example
