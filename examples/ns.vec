as std import print, println

namespace ns:
    enum e:
        one
        two

    proc what():
        e label1 = e::one
        e label2 = e::one
        if label1 != label2:
            std::println("labels differ")
        if label1 == label2:
            std::println("labels are equal")

    proc what(int i):
        std::print("on what(int): ")
        std::println(i)
